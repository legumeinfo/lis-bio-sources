<?xml version="1.0"?>
<classes>

  <!-- a GeneFunction is a Steven Cannon invention to associate Genes to Traits based on literature curation -->
  <class name="GeneFunction" extends="Annotatable" is-interface="true">
    <attribute name="classicalLocus" type="java.lang.String"/>
    <attribute name="comments" type="java.lang.String"/>
    <attribute name="curators" type="java.lang.String"/>
    <attribute name="pubName" type="java.lang.String"/>
    <attribute name="symbol" type="java.lang.String"/>
    <attribute name="symbolLong" type="java.lang.String"/>
    <attribute name="synopsis" type="java.lang.String"/>
    <attribute name="confidence" type="java.lang.Integer"/>
    <collection name="gene" referenced-type="Gene" reverse-reference="geneFunctions"/>
    <collection name="trait" referenced-type="Trait" reverse-reference="geneFunctions"/>
	  <!-- these come from Annotatable <collection name="publications" referenced-type="Publication" reverse-reference="geneFunctions"/>-->
  </class>

  <class name="Gene" is-interface="true">
    <collection name="geneFunctions" referenced-type="GeneFunction" reverse-reference="gene"/>
  </class>

  <class name="Trait" is-interface="true">
    <collection name="geneFunctions" referenced-type="GeneFunction" reverse-reference="trait"/>
  </class>

</classes>
